<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.MonthlyUnitNetValueMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.example.entity.MonthlyUnitNetValue">
        <id column="id" property="id" />
        <result column="price_date" property="priceDate" />
        <result column="unit_net_value" property="unitNetValue" />
        <result column="is_business_use" property="isBusinessUse" />
        <result column="generate_time" property="generateTime" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="remark" property="remark" />
        <result column="valid_status" property="validStatus" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, price_date, unit_net_value, is_business_use, generate_time, create_time, update_time, remark, valid_status
    </sql>


    <!-- 按月份统计净值 -->
    <select id="selectUnitnetValueByPriceDate" resultType="java.util.HashMap">
        SELECT
            price_date,
            unit_net_value
        FROM monthly_unit_net_value
        WHERE price_date BETWEEN #{startDate} AND #{endDate}
          AND is_business_use = 1 AND valid_status = 1
        GROUP BY price_date
        ORDER BY price_date ASC
    </select>

</mapper>
